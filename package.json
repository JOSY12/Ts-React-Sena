{
  "name": "ts-practica-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck:tests && npm run test && npm run build",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test:browser": "node scripts/smoke-browser.mjs",
    "format": "prettier --write src tests scripts public *.config.* tsconfig*.json package.json index.html .github/workflows .prettierrc.json",
    "format:check": "prettier --check src tests scripts public *.config.* tsconfig*.json package.json index.html .github/workflows .prettierrc.json"
  },
  "dependencies": {
    "@clerk/localizations": "4.24.7",
    "@tailwindcss/vite": "4.3.5",
    "axios": "1.21.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-icons": "5.7.0",
    "react-router-dom": "7.18.5",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.5",
    "zustand": "5.1.0",
    "@clerk/react": "6.18.7",
    "@clerk/ui": "1.42.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/estree": "1.0.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "overrides": {
    "minimatch": "11.0.8"
  },
  "packageManager": "npm@11.21.2",
  "allowScripts": {
    "@swc/core@1.16.22": true,
    "core-js": false
  }
}
